SAB_STRANDED_COUNT=0
SAB_CANDIDATE_COUNT=0
SAB_MEDIA_STRANDED_COUNT=0
SAB_ARCHIVE_STRANDED_COUNT=0
SAB_OTHER_STRANDED_COUNT=0

SAB_RESIDUE_COUNT=0
SAB_SAMPLE_RESIDUE_COUNT=0
SAB_EMPTY_COUNT=0

RESOLVED_COUNT=0

